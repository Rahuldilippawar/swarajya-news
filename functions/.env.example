# Non-secret function configuration (loaded by the Firebase CLI from .env.<project>).
# Secrets such as the WhatsApp access token must be stored with
#   firebase functions:secrets:set WHATSAPP_ACCESS_TOKEN
# and never placed in this file or in Firestore.
PUBLIC_SITE_URL=https://example.com

# WhatsApp Cloud API (Meta). Secrets are NOT set here:
#   firebase functions:secrets:set WHATSAPP_ACCESS_TOKEN   (permanent system-user token)
#   firebase functions:secrets:set WHATSAPP_APP_SECRET     (Meta app secret, verifies webhooks)
#   firebase functions:secrets:set WHATSAPP_VERIFY_TOKEN   (any random string; also entered in Meta's webhook settings)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=news_bulletin
WHATSAPP_TEMPLATE_LANGUAGE=mr
