rules_version = '2';

// Thumbnails and photographs uploaded from the panels. Videos are never stored
// here — they live on the official YouTube channel.
service firebase.storage {
  match /b/{bucket}/o {
    function staff() {
      return request.auth != null
        && request.auth.token.get('role', '') in ['SUPER_ADMIN', 'EDITOR', 'REPORTER', 'OWNER'];
    }

    match /news-images/{uid}/{fileName} {
      allow read: if true;
      allow create: if staff()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }

    match /ads/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.get('role', '') in ['SUPER_ADMIN', 'OWNER']
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
