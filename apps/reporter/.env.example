# Firebase web app config (Firebase console → Project settings → Your apps).
# These values are public identifiers, not secrets; access is enforced by
# Firestore Security Rules and App Check.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to talk to the local Firebase emulators (npm run emulators).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Optional: reCAPTCHA Enterprise site key for Firebase App Check.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
